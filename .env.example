# ================================
# REQUIRED Environment Variables
# ================================

# WalletConnect Project ID (REQUIRED)
# Get yours at: https://cloud.walletconnect.com
# 1. Sign up/Login to WalletConnect Cloud
# 2. Create a new project
# 3. Copy the Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ================================
# Polymarket API Configuration
# ================================

# Polymarket Gamma API (Public - No Auth Required)
# Used for fetching market data
NEXT_PUBLIC_GAMMA_API_URL=https://gamma-api.polymarket.com

# Polymarket CLOB API (Requires API Keys for Trading)
# Used for placing orders
NEXT_PUBLIC_CLOB_API_URL=https://clob.polymarket.com

# Polymarket Data API (Public)
# Used for historical data
NEXT_PUBLIC_DATA_API_URL=https://data-api.polymarket.com

# ================================
# Network Configuration
# ================================

# Polygon Mainnet Chain ID
NEXT_PUBLIC_CHAIN_ID=137

# ================================
# POLYMARKET BUILDER PROGRAM (OPTIONAL)
# ================================

# Builder API Keys - Get from: https://polymarket.com/profile (Builders section)
# These are OPTIONAL and only needed if you're participating in the Builder Grant Program
#
# To get Builder API Keys:
# 1. Go to https://polymarket.com
# 2. Connect your wallet
# 3. Click profile → Builders
# 4. Create API keys
#
# IMPORTANT: These are SERVER-SIDE keys and should NEVER be exposed in client code!
# Use these ONLY in server-side functions or a builder signing server.

# POLY_BUILDER_API_KEY=your_builder_api_key_here
# POLY_BUILDER_SECRET=your_builder_secret_here
# POLY_BUILDER_PASSPHRASE=your_builder_passphrase_here

# Builder Signing Server URL (if using remote signing)
# NEXT_PUBLIC_BUILDER_SIGNING_SERVER_URL=https://your-signing-server.com/sign

# ================================
# IMPORTANT NOTES
# ================================

# 1. WALLETCONNECT PROJECT ID
#    - This is REQUIRED for wallet connectivity
#    - Get it from: https://cloud.walletconnect.com
#    - Free tier is sufficient for development
#
# 2. POLYMARKET API
#    - Gamma API: Public, no authentication needed
#    - CLOB API: User API keys are generated client-side using wallet signature
#    - No server-side API keys needed for basic functionality
#
# 3. BUILDER PROGRAM (OPTIONAL)
#    - Builder keys are ONLY needed for grant program participation
#    - These keys enable order attribution to your builder account
#    - You can use the app WITHOUT builder keys (end-user mode)
#    - With builder keys: Orders are attributed to you for grant tracking
#    - Without builder keys: App works normally, no attribution
#
# 4. POLYGON MAINNET
#    - Make sure users have USDC on Polygon
#    - Bridge: https://wallet.polygon.technology/polygon/bridge
#
# 5. FOR VERCEL DEPLOYMENT
#    - Add NEXT_PUBLIC_* variables in Vercel Dashboard
#    - Project Settings → Environment Variables
#    - Builder keys should be kept server-side (use Vercel secret)
